[Unit]
Description=Project Forge self-introspection
After=network.target

[Service]
Type=oneshot
User=claude
WorkingDirectory=/opt/project-forge
EnvironmentFile=-/opt/project-forge/.env
# Use Claude Code CLI as LLM backend (no API key needed; rolls into the
# user's Claude subscription). Enables Sonnet-driven SI proposals
# instead of falling back to static heuristics.
Environment=FORGE_LLM_BACKEND=claude_code
Environment=FORGE_LLM_MODEL=sonnet
ExecStart=/opt/project-forge/scripts/introspect-daily.sh
# Sonnet on the heavy introspect prompt (file tree + commits + lint +
# issues + telemetry) takes 60-120s; bump from 120 to 300 for headroom.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
